{
  "name": "usfm",
  "displayName": "USFM",
  "scopeName": "source.usfm",
  "aliases": ["sfm"],
  "patterns": [
    { "include": "#id" },
    { "include": "#number" },
    { "include": "#caller" },
    { "include": "#reference" },
    { "include": "#marker" },
    { "include": "#attributes" },
    { "include": "#break" },
    { "include": "#nbsp" }
  ],
  "repository": {
    "id": {
      "match": "(\\\\id)(?:(\\s+)([A-Z0-9]{3}))?(?=\\s|$)",
      "captures": {
        "1": { "name": "keyword.control.marker.id.usfm" },
        "3": { "name": "entity.name.type.book.usfm" }
      }
    },
    "number": {
      "match": "(\\\\(?:c|ca|v|va))(?:(\\s+)(\\d+[a-z]?(?:[-,]\\d+[a-z]?)*))?(?=[\\s\\\\]|$)",
      "captures": {
        "1": { "name": "keyword.control.marker.number.usfm" },
        "3": { "name": "constant.numeric.usfm" }
      }
    },
    "caller": {
      "match": "(\\\\(?:f|fe|ef|x|ex))(\\s+)([+\\-]|[^\\s\\\\])(?=\\s|$)",
      "captures": {
        "1": { "name": "entity.name.tag.marker.note.usfm" },
        "3": { "name": "variable.parameter.caller.usfm" }
      }
    },
    "reference": {
      "match": "(\\\\(?:fr|xo))(\\s+)(\\d+[:.]\\d+[a-z]?(?:[-–,]\\d+[a-z]?)*)",
      "captures": {
        "1": { "name": "entity.name.tag.marker.usfm" },
        "3": { "name": "constant.numeric.reference.usfm" }
      }
    },
    "marker": {
      "patterns": [
        { "match": "\\\\\\+?[A-Za-z][A-Za-z_]*\\d*(?:-[se])?\\*?", "name": "entity.name.tag.marker.usfm" },
        { "match": "\\\\\\*", "name": "entity.name.tag.marker.closer.usfm" }
      ]
    },
    "attributes": {
      "begin": "\\|",
      "beginCaptures": { "0": { "name": "punctuation.separator.attributes.usfm" } },
      "end": "(?=\\\\)|$",
      "contentName": "meta.attributes.usfm",
      "patterns": [
        {
          "match": "([A-Za-z][\\w-]*)\\s*(=)\\s*(\")([^\"]*)(\")",
          "captures": {
            "1": { "name": "entity.other.attribute-name.usfm" },
            "2": { "name": "punctuation.separator.key-value.usfm" },
            "3": { "name": "string.quoted.double.usfm punctuation.definition.string.begin.usfm" },
            "4": { "name": "string.quoted.double.usfm" },
            "5": { "name": "string.quoted.double.usfm punctuation.definition.string.end.usfm" }
          }
        },
        {
          "match": "[^\\s=\"\\\\][^=\"\\\\]*?(?=\\s*(?:\\\\|$))",
          "name": "string.unquoted.attribute-value.default.usfm"
        }
      ]
    },
    "break": { "match": "//", "name": "punctuation.separator.break.usfm keyword.operator.break.usfm" },
    "nbsp": { "match": "~", "name": "constant.character.nbsp.usfm" }
  }
}
