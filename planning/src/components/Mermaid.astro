---
/**
 * A diagram in Mermaid syntax, rendered to SVG at build time by Ondine
 * (https://ondine.sh): no diagram library ships to the page. Colours come from
 * the site's tokens (`.ondine` in site.css), so dark mode is the token swap.
 * State machines: `stateDiagram-v2`, or `<Machine>` for one you can step.
 *   <Mermaid id="lifecycle">
 *   ```mermaid
 *   stateDiagram-v2
 *     idea --> discussing
 *   ```
 *   </Mermaid>
 * A diagram that does not parse shows its source and the parser's message
 * instead of failing the build.
 */
import { render } from "ondine/compiler";

interface Props { id?: string; code: string; caption?: string; "data-loc"?: string; "data-body"?: string }
const { id, code, caption, "data-loc": loc } = Astro.props;

let svg: string | undefined;
let error: string | undefined;
try {
  svg = render(code.trim()).svg;
} catch (cause) {
  error = cause instanceof Error ? cause.message : String(cause);
}
---
<figure data-ref={`diagram:${id ?? "?"}`} data-loc={loc} class="plans-diagram my-4 overflow-x-auto rounded-md border border-surface-border bg-surface-primary p-4">
  {svg !== undefined && <Fragment set:html={svg} />}
  {error !== undefined && (
    <div>
      <p class="m-0 text-small text-on-surface-error">This diagram does not parse: {error}</p>
      <pre class="mt-2 mb-0 text-small">{code}</pre>
    </div>
  )}
  {caption && <figcaption class="mt-2 text-small text-on-surface-secondary">{caption}</figcaption>}
</figure>
