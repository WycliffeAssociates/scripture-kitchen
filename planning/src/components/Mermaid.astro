---
/**
 * A diagram in Mermaid syntax, rendered to SVG at build time by Pele
 * (https://pele.run): no diagram library ships to the page. Colours come from
 * the site's tokens (`--pele-*` in site.css), so dark mode is the token swap.
 * State machines: `stateDiagram-v2`, or `<Machine>` for one you can step.
 *   <Mermaid id="lifecycle">
 *   ```mermaid
 *   stateDiagram-v2
 *     idea --> discussing
 *   ```
 *   </Mermaid>
 * A bare ```mermaid fence in any MDX file becomes one of these
 * (src/lib/remark-mermaid.ts). `click node "/atlas/cst"` makes a node a link.
 * A diagram wider than its box pans and zooms. One that does not parse shows
 * its source and the parser's message instead of failing the build.
 */
import { render } from "pele";
import { url } from "../lib/url.ts";

interface Props { id?: string; code: string; caption?: string; "data-loc"?: string; "data-body"?: string }
const { id, code, caption, "data-loc": loc } = Astro.props;

let svg: string | undefined;
let error: string | undefined;
try {
  // The drawing goes in a viewport group, so pan and zoom move it and not the frame.
  svg = render(code.trim()).svg
    .replace(/^(<svg\b[^>]*>)/u, "$1<g data-viewport>")
    .replace(/<\/svg>\s*$/u, "</g></svg>")
    // `click node "/atlas/cst"` links are site paths; put the deploy base in front.
    .replace(/(\bhref=")(\/[^/"][^"]*)"/gu, (_, attr: string, path: string) => `${attr}${url(path)}"`);
} catch (cause) {
  error = cause instanceof Error ? cause.message : String(cause);
}
---
<figure data-ref={`diagram:${id ?? "?"}`} data-loc={loc} class="plans-diagram my-4 rounded-md border border-surface-border bg-surface-primary p-4">
  {svg !== undefined && <div class="graph overflow-hidden" data-graph="fit"><Fragment set:html={svg} /></div>}
  {error !== undefined && (
    <div>
      <p class="m-0 text-small text-on-surface-error">This diagram does not parse: {error}</p>
      <pre class="mt-2 mb-0 text-small">{code}</pre>
    </div>
  )}
  {caption && <figcaption class="mt-2 text-small text-on-surface-secondary">{caption}</figcaption>}
</figure>

<script>
  import { mountPanZoom } from "../client/panzoom.ts";
  mountPanZoom();
</script>
