---
/**
 * One cited range for a concept page's code sidebar: the lines, three of
 * context either side (faded), numbered as in the file, coloured at build.
 *
 *   <CodeCite path="onion/src/cst.rs" start={21} end={32} id="c1x…" />
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { githubBlob } from "../../lib/atlas/github.ts";
import { highlight, langOf } from "../../lib/highlight.ts";
import { repoRoot } from "../../lib/root.ts";

interface Props { path: string; start: number; end: number; id: string; label: string; hidden?: boolean }
const { path, start, end, id, label, hidden = false } = Astro.props;

const CONTEXT = 3;
const all = readFileSync(join(repoRoot, path), "utf8").split("\n");
const from = Math.max(1, start - CONTEXT);
const to = Math.min(all.length, end + CONTEXT);
const width = String(to).length;
const html = await highlight(all.slice(from - 1, to).join("\n"), langOf(path), (i) => {
  const n = from + i - 1;
  return { gutter: String(n).padStart(width), "data-ctx": n < start || n > end ? "" : undefined };
});
const lines = start === end ? `L${start}` : `L${start}–L${end}`;
---
<figure data-cite-block={id} hidden={hidden} class="code cite-block m-0">
  <figcaption class="cite-head">
    <span class="min-w-0 truncate"><span class="cite-label">{label}</span> <span class="cite-where">{path}:{lines}</span></span>
    <a href={`${githubBlob(path)}#L${start}-L${end}`} class="shrink-0">GitHub ↗</a>
  </figcaption>
  <Fragment set:html={html} />
</figure>
