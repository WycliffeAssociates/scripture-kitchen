---
/**
 * A real parse, byte by byte: the USFM on the left, the buffer it became on
 * the right. Every byte is coloured by the field that owns it; hover or tap
 * one to see the whole field, its decoded value, and the source it points at.
 */
import "../../styles/wires.css";
import type { Sample } from "../../lib/atlas/layouts.ts";
import { byteView, cellsOf, rowView } from "../../lib/atlas/hex-lines.ts";
import { url } from "../../lib/url.ts";

interface Props {
  sample: Sample;
  usfmPath: string;
  binPath: string;
}
const { sample, usfmPath, binPath } = Astro.props;
const hex = (n: number, w: number): string => n.toString(16).padStart(w, "0");
const hueAt = (i: number): string => {
  const s = sample.spans[sample.owner[i] ?? -1];
  return s && s.hue ? `--c: var(--crate-${s.hue})` : "";
};
const cells = cellsOf(sample);
const views = [
  { name: "bytes", view: byteView(sample), gutter: 1 },
  { name: "rows", view: rowView(sample), gutter: 2 },
] as const;
const blobs = sample.regions.filter((r) => r.kind === "blob" && !r.holds);
const data = JSON.stringify({ spans: sample.spans, owner: sample.owner }).replace(/</gu, "\\u003c");
const size = (r: Sample["regions"][number]): string => {
  if (r.kind === "fixed" || r.kind === "blob") return `${r.end - r.at} B`;
  const own = r.entries.filter((e) => e.record === r.record || r.record === undefined);
  return `${own.length} × ${own[0]?.stride ?? 0} B${own.length < r.entries.length ? ` + ${r.entries.length - own.length} tail rows` : ""}`;
};
---
<section class="wsample" data-wsample>
  <header class="wsample-head">
    <h2 class="text-h4 font-semibold">One real parse</h2>
    <p class="text-small text-on-surface-secondary">
      <code>{usfmPath}</code> → <code>{binPath}</code>, {sample.bytes.length} bytes. Offsets are
      {sample.utf16 ? " UTF-16 code units" : " UTF-8 bytes"} into the text.
      {sample.partial && <strong class="text-on-surface-warning"> Bytes past the header are not mapped for this format.</strong>}
    </p>
  </header>

  <div class="wreadout" aria-live="polite" data-readout>
    <span class="text-on-surface-tertiary">Hover or tap a byte.</span>
  </div>

  <div class="wsample-panes">
    <pre class="wusfm" data-usfm>{sample.segments.map(([from, to, text]) => <span data-b0={from} data-b1={to}>{text}</span>)}</pre>
    <div class="whex-box">
      <div class="whex-bar" role="group" aria-label="Hex layout">
        <span class="text-on-surface-tertiary">Lay out</span>
        <button type="button" data-view-btn="bytes" aria-pressed="true">16 per line</button>
        <button type="button" data-view-btn="rows" aria-pressed="false">one row per line</button>
      </div>
      {views.map(({ name, view, gutter }) => (
        <div class="whex" data-hex={name} hidden={name !== "bytes"} style={`--w: ${view.width}; --g: ${gutter}`}>
          {view.lines.map((line) => {
            if (line.kind === "label") return (
              <div class="whex-label"><span class="whex-off">{hex(line.at, 4)}</span><b>{line.name}</b> <span>{line.note}</span></div>
            );
            if (line.kind === "empty") return (
              <div class="whex-label whex-empty"><span class="whex-off">{hex(line.at, 4)}</span><span>{line.names.join(", ")}: empty in this sample</span></div>
            );
            if (line.kind === "fields") return (
              <div class="whex-row whex-fields" aria-hidden="true">
                {line.fields.map((f) => (
                  <span style={`grid-column: ${gutter + 1 + f.col} / span ${f.width}; ${f.hue ? `--c: var(--crate-${f.hue})` : ""}`} title={f.name}>{f.name}</span>
                ))}
              </div>
            );
            return (
              <div class="whex-row">
                <span class="whex-off">{hex(line.off, 4)}</span>
                {gutter > 1 && <span class="whex-tag">{line.tag}</span>}
                {line.cells.map((i) => {
                  if (i === null) return <b class="wpad" aria-hidden="true" />;
                  const own = sample.owner[i] ?? -1;
                  const cell = cells[i];
                  return (
                    <i
                      data-i={i}
                      data-r={cell?.row || undefined}
                      data-row={cell?.rowStart ? cell.rowStart.split(" ").at(-1) : undefined}
                      class:list={[own < 0 && "wfree", cell?.rowStart && "wrow"]}
                      style={hueAt(i)}
                      title={cell?.rowStart}
                    >{hex(sample.bytes[i] ?? 0, 2)}</i>
                  );
                })}
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>

  <ul class="wregions">
    {sample.regions.map((r) => (
      <li data-from={r.at} data-to={r.end} tabindex="0">
        <span class="font-mono">{r.name}</span>
        <span class="text-on-surface-tertiary">@{r.at} · {size(r)}{r.holds && <> · <a href={url(`/atlas/wires/${r.holds}`)}>{r.holds}</a></>}</span>
      </li>
    ))}
  </ul>

  {blobs.map((r) => (
    <div class="wblob">
      <h3 class="font-mono text-small font-semibold">{r.name} <span class="font-normal text-on-surface-tertiary">UTF-8 text, {r.end - r.at} bytes</span></h3>
      {r.end === r.at
        ? <p class="text-small text-on-surface-tertiary">Empty in this sample.</p>
        : (
          <div class="wblob-cells">
            {sample.spans.filter((s) => s.region === r.name && s.space === "text").map((s) => (
              <span data-i={s.start} style={`--n: ${s.end - s.start}`}>{JSON.parse(s.value)}</span>
            ))}
          </div>
        )}
    </div>
  ))}

  <script type="application/json" data-wsample-json set:html={data} />
</section>

<script>
  import { mountWireSample } from "../../client/wire-sample.ts";
  for (const root of document.querySelectorAll<HTMLElement>("[data-wsample]")) mountWireSample(root);
</script>
