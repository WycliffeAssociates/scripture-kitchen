  /**
   * The index of the token whose `[start, end)` contains `offset`.
   *
   * Tokens partition the source, so this is TOTAL for `0 <= offset <
   * sourceLength`; an offset outside the document is a `RangeError` rather
   * than a clamp, because a clamped answer names the wrong marker.
   */
  tokenAt(offset: number): number {
    const n = this.tokens.length;
    const end = n === 0 ? 0 : this.tokens.seek(n - 1).end;
    if (offset < 0 || offset >= end) {
      throw new RangeError(`offset ${offset} is outside 0..${end}`);
    }
    let lo = 0;
    let hi = n - 1;
    let found = 0;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (this.tokens.seek(mid).start <= offset) {
        found = mid;
        lo = mid + 1;
      } else hi = mid - 1;
    }
    return found;
  }

  /**
   * The smallest node whose extent covers `[from, to)` — what WRAPS a range.
   *
   *   \v 1 Jesus \add wept\add*.
   *              enclosing(hit of "wept") → the `\add` node, `marker` its row
   *
   * The walk is the owner of `tokenAt(from)`, then up while the extent falls
   * short of `to`. The root covers everything, so this is total; `marker` is
   * the opening token's row, `0` on the root. An empty range asks about the
   * point at `from`.
   */
  enclosing(
    from: number,
    to: number,
  ): { node: number; token: number; marker: number; from: number; to: number } {
    const token = this.tokenAt(from);
    const end = Math.max(to, from + 1);
    let node = this.owners()[token];
    for (;;) {
      const span = this.extent(node);
      if (span.from <= from && end <= span.to) break;
      const up = this.parent(node);
      if (up === NONE) break;
      node = up;
    }
    const span = this.extent(node);
    const opener = this.nodes.seek(node).token;
    return {
      node,
      token,
      marker: opener === NONE ? 0 : this.tokens.seek(opener).marker,
      from: span.from,
      to: span.to,
    };
  }

  /**
   * Every token overlapping `[from, to)`, clipped to it, in document order.
   * `kind` carries no spelling bit; `marker` is the row, or 0.
   *
   * What a range is MADE of, where `enclosing` is what it sits in.
   */
  spansIn(from: number, to: number): { from: number; to: number; kind: number; marker: number }[] {
    const out: { from: number; to: number; kind: number; marker: number }[] = [];
    const n = this.tokens.length;
    if (to <= from || n === 0) return out;
    let lo = 0;
    let hi = n - 1;
    let i = 0;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (this.tokens.seek(mid).start <= from) {
        i = mid;
        lo = mid + 1;
      } else hi = mid - 1;
    }
    for (; i < n; i++) {
      // Every field is read before the cursor moves again.
      const r = this.tokens.seek(i);
      const start = r.start;
      const stop = r.end;
      const kind = r.kind & ~TOKEN_SPELLING_BIT;
      const marker = r.marker;
      if (start >= to) break;
      if (stop <= from) continue;
      out.push({ from: Math.max(start, from), to: Math.min(stop, to), kind, marker });
    }
    return out;
  }

  /** True when no `Text` bytes lie in `[from, to)` — the range is all markup. */
  inMarkup(from: number, to: number): boolean {
    return this.spansIn(from, to).every((span) => span.kind !== TokenKind.Text);
  }
}

/** Every token, as a sequence. */
export class Tokens {
  readonly rows: TokenRow;

  constructor(rows: TokenRow) {
    this.rows = rows;
  }

  get length(): number {
    return this.rows.length;
  }

  at(i: number): TokenView {
    return new TokenView(this.rows, i);
  }

  *[Symbol.iterator](): IterableIterator<TokenView> {
    for (let i = 0, n = this.rows.length; i < n; i++) yield new TokenView(this.rows, i);
  }

  /**
   * Every token WITHOUT allocating a view per row — the shape a whole-book
   * syntax pass wants. Return `false` to stop.
   *
   * `markerIdx` is an INDEX, not a resolved row, and that is deliberate: the
   * point of this path is that it allocates nothing, and a `Marker` per token
   * is exactly what it exists to avoid. The 153-row table ships in this file,
   * so `MARKERS[markerIdx]` resolves it with one array read and no call — the
   * row is still local, it is simply not wrapped.
   */
  forEach(fn: (kind: number, markerIdx: number, from: number, to: number) => void | boolean): void {
    for (let i = 0, n = this.rows.length; i < n; i++) {
      const r = this.rows.seek(i);
      if (fn(r.kind, r.marker, r.start, r.end) === false) return;
    }
  }
}

/** One edit of a repair. */
export interface FixEdit extends Span {
  insert: string;
}

/** One finding. */
export class DiagnosticView {
  readonly id: number;
  private readonly d: DiagnosticRow;
  private readonly f: FixRow;
  private readonly e: EditRow;
  private readonly text: string;

  constructor(d: DiagnosticRow, f: FixRow, e: EditRow, text: string, id: number) {
    this.d = d;
    this.f = f;
    this.e = e;
    this.text = text;
    this.id = id;
  }

  /** The catalog row: name, category, severity ladder, template. */
  code(): (typeof CODES)[number] {
    return CODES[this.d.seek(this.id).code];
  }

  span(): Span {
    const r = this.d.seek(this.id);
    return { from: r.from, to: r.to };
  }

  /** The other party — an opener, an owner, a first occurrence — or `null`. */
  second(): Span | null {
    const r = this.d.seek(this.id);
    return r.secondFrom === NONE ? null : { from: r.secondFrom, to: r.secondTo };
  }

  /** The code's aux integer. What it MEANS is `code().aux`. */
  aux(): number {
    return this.d.seek(this.id).aux;
  }

  /** The offered repair, or `null`. */
  fix(): FixEdit[] | null {
    const at = this.d.seek(this.id).fix;
    if (at === NONE) return null;
    const f = this.f.seek(at);
    const out: FixEdit[] = [];
    for (let i = f.editFrom; i < f.editTo; i++) {
      const e = this.e.seek(i);
      out.push({
        from: e.from,
        to: e.to,
        insert: this.text.slice(e.textFrom, e.textFrom + e.textLen),
      });
    }
    return out;
  }

  /**
   * The severity this code carries in a document declaring `version` — the
   * ladder, walked. `null` means the code says nothing at that version.
   */
  severity(version: string | null): string | null {
    const row = this.code();
    let severity = row.severity;
    if (version === null) return severity;
    for (const [rung, at] of row.escalation) if (rung <= version) severity = at;
    return severity;
  }

  /**
   * The message, rendered from the template and the document's own bytes.
   * `slice` is the editor's `doc.sliceString`; no text crosses the wall to
   * make this.
   */
  message(slice: (from: number, to: number) => string): string {
    const span = this.span();
    const second = this.second();
    return this.code()
      .template.replace("{anchor}", slice(span.from, span.to))
      .replace("{second}", second ? slice(second.from, second.to) : "");
  }

  /** Where to go look: the chapter and verse containing this finding. */
  locate(toc: Toc): { chapter: number; verse: number } | null {
    return toc.at(this.span().from);
  }
}

/** Findings, as a sequence. */
export class Diagnostics {
  private readonly d: DiagnosticRow;
  private readonly f: FixRow;
  private readonly e: EditRow;
  private readonly text: string;

  constructor(d: DiagnosticRow, f: FixRow, e: EditRow, text: string) {
    this.d = d;
    this.f = f;
    this.e = e;
    this.text = text;
  }

  get length(): number {
    return this.d.length;
  }

  at(i: number): DiagnosticView {
    return new DiagnosticView(this.d, this.f, this.e, this.text, i);
  }

  *[Symbol.iterator](): IterableIterator<DiagnosticView> {
    for (let i = 0, n = this.d.length; i < n; i++) yield this.at(i);
  }
}

/** The chapter and verse index. Over the TOKEN stream, not the tree. */
/**
 * One thing a verse designator covers: `\\v 1,3,5` is three, `\\v 12a-14b`
 * one. A segment is a place INSIDE its number, so `12a` and `12b` are two
 * places; its span is empty when none is written.
 */
export interface VerseMember {
  from: number;
  fromSegment: Span;
  to: number;
  toSegment: Span;
}

export class Toc {
  readonly chapterRows: ChapterRow;
  readonly verseRows: VerseRow;
  readonly memberRows: MemberRow;

  constructor(chapterRows: ChapterRow, verseRows: VerseRow, memberRows: MemberRow) {
    this.chapterRows = chapterRows;
    this.verseRows = verseRows;
    this.memberRows = memberRows;
  }

  /**
   * Every chapter. `label` is the designator as written (`12b`), a span into
   * the source — empty when the `\\c` has none, and on row 0.
   */
  chapters(): {
    number: number;
    token: number;
    designator: number;
    from: number;
    to: number;
    label: Span;
  }[] {
    const out = [];
    for (let i = 0, n = this.chapterRows.length; i < n; i++) {
      const r = this.chapterRows.seek(i);
      out.push({
        number: r.number,
        token: r.token,
        designator: r.designator,
        from: r.start,
        to: r.end,
        label: { from: r.labelStart, to: r.labelEnd },
      });
    }
    return out;
  }

  /**
   * Every verse anchor. `first..last` is the HULL — a bridge `\\v 5-7` and a
   * list `\\v 5,7` both span 5 to 7 — and `members` is what it COVERS, so a
   * list's holes are visible. `label` is the designator as written.
   */
  verses(): {
    chapter: number;
    first: number;
    last: number;
    at: number;
    token: number;
    designator: number;
    label: Span;
    members: VerseMember[];
  }[] {
    const out = [];
    for (let i = 0, n = this.verseRows.length; i < n; i++) {
      const r = this.verseRows.seek(i);
      out.push({
        chapter: r.chapter,
        first: r.first,
        last: r.last,
        at: r.at,
        token: r.token,
        designator: r.designator,
        label: { from: r.labelStart, to: r.labelEnd },
        members: this.membersOf(i),
      });
    }
    return out;
  }

  /** What verse row `n`'s designator covers, in written order. */
  membersOf(n: number): VerseMember[] {
    const r = this.verseRows.seek(n);
    const out: VerseMember[] = [];
    for (let i = r.membersFrom, end = r.membersFrom + r.membersLen; i < end; i++) {
      const m = this.memberRows.seek(i);
      out.push({
        from: m.from,
        fromSegment: { from: m.fromSegmentStart, to: m.fromSegmentEnd },
        to: m.to,
        toSegment: { from: m.toSegmentStart, to: m.toSegmentEnd },
      });
    }
    return out;
  }

  /**
   * Every chapter without allocating a row object — the twin of
   * `Tokens.forEach`, for a consumer that reads the toc per commit. Return
   * `false` to stop.
   */
  forEachChapter(
    fn: (number: number, from: number, to: number, token: number, designator: number) => void | boolean,
  ): void {
    for (let i = 0, n = this.chapterRows.length; i < n; i++) {
      const r = this.chapterRows.seek(i);
      if (fn(r.number, r.start, r.end, r.token, r.designator) === false) return;
    }
  }

  /** Every verse anchor, the same way. */
  forEachVerse(
    fn: (
      chapter: number,
      first: number,
      last: number,
      at: number,
      token: number,
      designator: number,
    ) => void | boolean,
  ): void {
    for (let i = 0, n = this.verseRows.length; i < n; i++) {
      const r = this.verseRows.seek(i);
      if (fn(r.chapter, r.first, r.last, r.at, r.token, r.designator) === false) return;
    }
  }

  /**
   * The chapter:verse address containing `pos` — the reverse index. Chapters
   * tile, so the chapter is a binary search; the verse is the last anchor at
   * or before `pos` within it.
   */
  at(pos: number): { chapter: number; verse: number } | null {
    const chapters = this.chapterRows;
    if (chapters.length === 0) return null;
    let lo = 0;
    let hi = chapters.length - 1;
    let found = 0;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (chapters.seek(mid).start <= pos) {
        found = mid;
        lo = mid + 1;
      } else hi = mid - 1;
    }
    const chapter = chapters.seek(found).number;

    // Anchors are sorted by `at`, so the verse is the last one at or before
    // `pos` — a binary search, not a scan.
    const verses = this.verseRows;
    lo = 0;
    hi = verses.length - 1;
    let verse = 0;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      const r = verses.seek(mid);
      if (r.at <= pos) {
        if (r.chapter === chapter) verse = r.first;
        lo = mid + 1;
      } else hi = mid - 1;
    }
    return { chapter, verse };
  }
}

// ---------------------------------------------------------------------------
// Attributes — the one export whose wire is a flat array, not a dish
// ---------------------------------------------------------------------------

/** u32s per attribute in what `attrs` returns: name span, then value span. */
export const ATTR_STRIDE = 4;

/** One attribute list, decoded. A bare value has an EMPTY name span. */
export interface AttrList {
  attrs: { name: Span; value: Span }[];
  /** `code` is a `MalformedAttr`. Absent when the list parsed clean. */
  malformed?: { code: number; at: number };
}

/**
 * What the wasm `attrs(text, from, to, opts?)` export returns, as objects.
 *
 *   const list = attrList(rawAttrs(text, from, to, { utf16: true }));
 *   for (const { name, value } of list.attrs) …
 *
 * Four words per attribute and two at the tail, in whatever space the call
 * asked for. A malformed tail ENDS the list, so it is one finding and always
 * the last thing in the array.
 */
export function attrList(flat: Uint32Array | readonly number[]): AttrList {
  const attrs: { name: Span; value: Span }[] = [];
  for (let at = 0; at + ATTR_STRIDE <= flat.length - 2; at += ATTR_STRIDE) {
    attrs.push({
      name: { from: flat[at], to: flat[at + 1] },
      value: { from: flat[at + 2], to: flat[at + 3] },
    });
  }
  const code = flat[flat.length - 2];
  return code === NONE ? { attrs } : { attrs, malformed: { code, at: flat[flat.length - 1] } };
}

/** What a parse should compute. Everything defaults off except the tree. */
export interface ParseOptions {
  /** Run the lint walk — the one expensive optional. */
  diagnostics?: boolean;
  /** Build the chapter and verse index. Cheap, and needs no tree. */
  toc?: boolean;
  /** Emit every offset as a UTF-16 code unit instead of a byte. */
  utf16?: boolean;
}

/** The wasm export's own shape — `parse`, or a `Galley`'s `parseText` bound to it. */
export type RawParse = (text: string, opts?: ParseOptions) => Uint8Array;

/**
 * The typed door over a wasm build: the buffer, deserialized.
 *
 *   const onion = reader(parse);
 *   const dish = onion.parse(text, { diagnostics: true });
 *
 * The same `ParseOptions` cross the wall: a typo is a compile error here and,
 * for a caller the compiler never saw, a throw naming the key at the wall.
 *
 * Takes the raw export rather than importing one, so this file is agnostic
 * about which build it sits beside — bundler, web or node.
 */
export function reader(rawParse: RawParse): { parse(text: string, opts?: ParseOptions): Dish } {
  return {
    parse(text: string, opts: ParseOptions = {}): Dish {
      return deserialize(rawParse(text, opts));
    },
  };
}

/** What `deserialize` hands back. */
export interface Dish {
  tree: Tree;
  tokens: Tokens;
  diagnostics: Diagnostics;
  toc: Toc;
  /** True when every offset is a UTF-16 code unit. */
  utf16: boolean;
  /**
   * The `\usfm` ladder index the document declares, or `NONE`. Decode with
   * `declaredVersion`.
   *
   * Crosses unconditionally because it GATES diagnostics: a finding's severity
   * is not knowable without it, and several codes say nothing at all until a
   * version is declared.
   */
  usfmVersion: number;
  /**
   * The source's length in the same space as every offset here — bytes, or
   * UTF-16 code units under `utf16`. An end-of-document position without
   * holding the text.
   */
  sourceLength: number;
  /**
   * xxh3-64 of the source BYTES, whatever space the offsets are in. Two dishes
   * of one document agree; the flag does not enter into it.
   */
  sourceHash: bigint;
}

/** The declared version as the string `DiagnosticView.severity` wants. */
export const declaredVersion = (dish: { usfmVersion: number }): string | null =>
  dish.usfmVersion === NONE ? null : (USFM_VERSIONS[dish.usfmVersion] ?? null);

/** `"ONCP"`, little-endian — a whole project, not one parse. */
export const CORPUS_MAGIC = 0x50434e4f;

/** Bumped when the envelope changes. Independent of each dish's own version. */
export const CORPUS_FORMAT_VERSION = 1;

/** One book out of a project buffer: the key you gave, and its parse. */
export interface CorpusBook {
  /** Carried back verbatim — onion never parses a key. */
  key: string;
  dish: Dish;
}

/**
 * Read a whole project.
 *
 * The envelope only frames: each book's bytes are exactly what a single parse
 * writes, so this decodes through `deserialize` and there is one reader for
 * both doors.
 *
 * Books are decoded LAZILY — the getter parses on first touch. A project-wide
 * findings panel that only wants counts should not pay to build a tree per
 * book.
 */
export function deserializeCorpus(bytes: Uint8Array): CorpusBook[] {
  const head = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
  if (head.getUint32(0, true) !== CORPUS_MAGIC) throw new Error("onion: not a corpus buffer");
  const version = head.getUint32(4, true);
  if (version !== CORPUS_FORMAT_VERSION) {
    throw new Error(`onion: corpus version ${version}, reader expects ${CORPUS_FORMAT_VERSION}`);
  }
  const count = head.getUint32(8, true);
  const decoder = new TextDecoder();
  const out: CorpusBook[] = [];
  for (let n = 0; n < count; n++) {
    const entry = 16 + n * 16;
    const keyAt = head.getUint32(entry, true);
    const keyLen = head.getUint32(entry + 4, true);
    const dishAt = head.getUint32(entry + 8, true);
    const dishLen = head.getUint32(entry + 12, true);
    const key = decoder.decode(new Uint8Array(bytes.buffer, bytes.byteOffset + keyAt, keyLen));
    let dish: Dish | null = null;
    out.push({
      key,
      get dish(): Dish {
        dish ??= deserialize(new Uint8Array(bytes.buffer, bytes.byteOffset + dishAt, dishLen));
        return dish;
      },
    });
  }
  return out;
}

/**
 * Read one plated parse.
 *
 * Refuses a dish whose magic or version it does not recognise, rather than
 * misreading one.
 */
export function deserialize(dish: Uint8Array): Dish {
  const head = new DataView(dish.buffer, dish.byteOffset, dish.byteLength);
  if (head.getUint32(0, true) !== MAGIC) throw new Error("onion: not a parse buffer");
  const version = head.getUint32(4, true);
  if (version !== FORMAT_VERSION) {
    throw new Error(`onion: wire version ${version}, reader expects ${FORMAT_VERSION}`);
  }
  const count = head.getUint32(8, true);
  const utf16 = (head.getUint32(12, true) & FLAG_UTF16) !== 0;
  const usfmVersion = head.getUint32(16, true);
  const sourceLength = head.getUint32(20, true);
  const sourceHash = head.getBigUint64(24, true);

  const view = (n: number): DataView => {
    const at = head.getUint32(HEADER_BYTES + n * 8, true);
    const len = head.getUint32(HEADER_BYTES + n * 8 + 4, true);
    return new DataView(dish.buffer, dish.byteOffset + at, len);
  };
  if (count !== SECTION_NAMES.length) {
    throw new Error(`onion: ${count} sections, reader expects ${SECTION_NAMES.length}`);
  }

  const childIdsView = view(SECTION.childIds);
  const childIds = new Uint32Array(
    childIdsView.buffer,
    childIdsView.byteOffset,
    childIdsView.byteLength / 4,
  );
  const fixTextView = view(SECTION.fixText);
  const fixText = new TextDecoder().decode(
    new Uint8Array(fixTextView.buffer, fixTextView.byteOffset, fixTextView.byteLength),
  );

  const tokens = new TokenRow(view(SECTION.tokens));
  const tree = new Tree(new NodeRow(view(SECTION.nodes)), tokens, childIds);
  return {
    tree,
    tokens: new Tokens(tokens),
    diagnostics: new Diagnostics(
      new DiagnosticRow(view(SECTION.diagnostics)),
      new FixRow(view(SECTION.fixes)),
      new EditRow(view(SECTION.edits)),
      fixText,
    ),
    toc: new Toc(
      new ChapterRow(view(SECTION.chapters)),
      new VerseRow(view(SECTION.verses)),
      new MemberRow(view(SECTION.members)),
    ),
    utf16,
    usfmVersion,
    sourceLength,
    sourceHash,
  };
}
