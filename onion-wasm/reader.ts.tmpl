    this.cachedOwnership = { owners, parents };
    return this.cachedOwnership;
  }

  private childRange(node: number): number[] {
    const r = this.nodes.seek(node);
    return [r.childFrom, r.childTo];
  }

  /**
   * The innermost node containing `pos` — the caret question.
   *
   * A descent, not a scan: at each level the containing child wins, so nesting
   * (`\p` inside `\esb`) resolves to the inner one.
   */
  nodeAt(pos: number): NodeView | null {
    let best: number | null = null;
    let node = 0;
    for (;;) {
      const [from, to] = this.childRange(node);
      let next: number | null = null;
      for (let slot = from; slot < to; slot++) {
        const id = this.childIds[slot];
        if ((id & NODE_ID_BIT) === 0) continue;
        const child = id & ~NODE_ID_BIT;
        const span = this.extent(child);
        // Children are in document order, so once one starts past `pos`
        // nothing after it can contain `pos` either.
        if (span.from > pos) break;
        if (pos < span.to) {
          next = child;
          break;
        }
      }
      if (next === null) return best === null ? null : new NodeView(this, best);
      best = next;
      node = next;
    }
