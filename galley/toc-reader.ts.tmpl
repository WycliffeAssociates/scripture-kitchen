    return this.#view.getUint32(this.#at + DIRECTORY_CHAPTER_ROWS_OFFSET, true);
  }

  /** `\c` markers in the book — [`chapterCount`](#chapterCount) less row 0. */
  get chapters(): number {
    return Math.max(0, this.chapterCount - 1);
