    const at = this.#view.getUint32(this.#at + DIRECTORY_ID_AT_OFFSET, true);
    const len = this.#view.getUint32(this.#at + DIRECTORY_ID_LEN_OFFSET, true);
    return UTF8.decode(this.#bytes.subarray(at, at + len));
