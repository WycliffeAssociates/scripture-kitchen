  get chapterRows(): ChapterRow {
    return new ChapterRow(this.#block(DIRECTORY_CHAPTERS_AT_OFFSET, this.chapterCount, CHAPTER_STRIDE));
  }

  /** A cursor over this book's verse anchors, in source order. */
  get verseRows(): VerseRow {
