[
  {
    "name": "the book is the whole text",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "book"},
    "expect": {"found": {"from": 0, "to": 74, "opening": 0, "covers": {"kind": "book"}, "coarser": false}}
  },
  {
    "name": "the intro is the front matter",
    "usfm": "\\id GEN\n\\mt1 Genesis\n\\c 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "intro"},
    "expect": {"found": {"from": 0, "to": 21, "opening": 0, "covers": {"kind": "intro"}, "coarser": false}}
  },
  {
    "name": "an empty intro is missing",
    "usfm": "\\c 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "intro"},
    "expect": {"missing": "intro"}
  },
  {
    "name": "one chapter runs to the next",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "chapters", "from": 2, "to": 2},
    "expect": {"found": {"from": 55, "to": 74, "opening": 55, "covers": {"kind": "chapters", "from": 2, "to": 2}, "coarser": false}}
  },
  {
    "name": "a chapter range spans its rows",
    "usfm": "\\id GEN\n\\c 1\n\\p a\n\\c 2\n\\p b\n\\c 3\n\\p c\n",
    "address": {"kind": "chapters", "from": 1, "to": 2},
    "expect": {"found": {"from": 8, "to": 28, "opening": 8, "covers": {"kind": "chapters", "from": 1, "to": 2}, "coarser": false}}
  },
  {
    "name": "two chapter 3s are ambiguous",
    "usfm": "\\c 3\n\\p a\n\\c 3\n\\p b\n",
    "address": {"kind": "chapters", "from": 3, "to": 3},
    "expect": {"ambiguous": [{"from": 0, "to": 10, "opening": 0}, {"from": 10, "to": 20, "opening": 10}]}
  },
  {
    "name": "a chapter the text lacks is missing",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "chapters", "from": 30, "to": 30},
    "expect": {"missing": "chapter"}
  },
  {
    "name": "a verse runs to the next verse or chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 39, "to": 55, "opening": 39, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a verse range spans both ends",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n\\v 2 b\n\\v 3 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 16, "to": 30, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a range may cross a chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 2, "verse": 1}},
    "expect": {"found": {"from": 39, "to": 74, "opening": 39, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 2, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "a verse in a bridge covers the bridge",
    "usfm": "\\c 1\n\\p\n\\v 1-2 a b\n\\v 3 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 8, "to": 19, "opening": 5, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a verse a list skips is missing",
    "usfm": "\\c 1\n\\p\n\\v 1,3 a\n\\v 4 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"missing": "verse", "within": {"from": 0, "to": 24}}
  },
  {
    "name": "a verse a list names covers its hull",
    "usfm": "\\c 1\n\\p\n\\v 1,3 a\n\\v 4 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"found": {"from": 8, "to": 17, "opening": 5, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 3}}, "coarser": false}}
  },
  {
    "name": "a segment the text does not divide is found coarser",
    "usfm": "\\c 1\n\\p\n\\v 3 a\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "a"}, "to": {"chapter": 1, "verse": 3, "segment": "a"}},
    "expect": {"found": {"from": 8, "to": 15, "opening": 5, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}}, "coarser": true}}
  },
  {
    "name": "a whole verse the text divides spans its segments",
    "usfm": "\\c 1\n\\p\n\\v 3a a\n\\v 3b b\n\\v 4 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"found": {"from": 8, "to": 24, "opening": 5, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "a"}, "to": {"chapter": 1, "verse": 3, "segment": "b"}}, "coarser": false}}
  },
  {
    "name": "a segment the text divides is exact",
    "usfm": "\\c 1\n\\p\n\\v 3a a\n\\v 3b b\n\\v 4 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "b"}, "to": {"chapter": 1, "verse": 3, "segment": "b"}},
    "expect": {"found": {"from": 16, "to": 24, "opening": 16, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "b"}, "to": {"chapter": 1, "verse": 3, "segment": "b"}}, "coarser": false}}
  },
  {
    "name": "two anchors for one verse are ambiguous",
    "usfm": "\\c 1\n\\p\n\\v 3 a\n\\v 3 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"ambiguous": [{"from": 8, "to": 15, "opening": 5}, {"from": 15, "to": 22, "opening": 15}]}
  },
  {
    "name": "a missing verse names its chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 9}, "to": {"chapter": 1, "verse": 9}},
    "expect": {"missing": "verse", "within": {"from": 8, "to": 55}}
  },
  {
    "name": "a range with a missing end is missing",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 9}},
    "expect": {"missing": "verse", "within": {"from": 8, "to": 55}}
  },
  {
    "name": "a verse in a missing chapter is a missing chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 7, "verse": 1}, "to": {"chapter": 7, "verse": 1}},
    "expect": {"missing": "chapter"}
  },
  {
    "name": "opening: a verse after a paragraph opens at the paragraph",
    "usfm": "\\c 1\n\\p\n\\v 1 a\n\\p\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 18, "to": 25, "opening": 15, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: a heading and its text open the verse",
    "usfm": "\\c 1\n\\p\n\\v 1 a\n\\s1 A heading\n\\p\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 32, "to": 39, "opening": 15, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: a poetry line opens the verse it starts",
    "usfm": "\\c 1\n\\q1 \\v 1 line one\n\\q2 line two\n\\q1 \\v 2 line three\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 40, "to": 56, "opening": 36, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: a blank line joins the run",
    "usfm": "\\c 1\n\\q1 \\v 1 a\n\\b\n\\q1 \\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 23, "to": 30, "opening": 16, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: mid-paragraph the opening is the verse",
    "usfm": "\\c 1\n\\p \\v 1 a \\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 15, "to": 22, "opening": 15, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: the first verse opens after its chapter marker",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 16, "to": 23, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a chapter label is not an opener",
    "usfm": "\\c 1\n\\cl Psalm 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 20, "to": 27, "opening": 17, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a psalm title is an opener",
    "usfm": "\\c 3\n\\d A psalm of David.\n\\q1 \\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 3, "verse": 1}, "to": {"chapter": 3, "verse": 1}},
    "expect": {"found": {"from": 30, "to": 37, "opening": 5, "covers": {"kind": "verses", "from": {"chapter": 3, "verse": 1}, "to": {"chapter": 3, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a range opens where its first verse does",
    "usfm": "\\c 1\n\\s1 Title\n\\p\n\\v 1 a\n\\p\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 18, "to": 35, "opening": 5, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "non-ASCII text: offsets are bytes",
    "usfm": "\\c 1\n\\s1 Ἐν ἀρχῇ\n\\p\n\\v 1 ἦν ὁ λόγος\n\\v 2 οὗτος\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 55, "to": 72, "opening": 55, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "non-ASCII text: a heading opening",
    "usfm": "\\c 1\n\\s1 Ἐν ἀρχῇ\n\\p\n\\v 1 ἦν ὁ λόγος\n\\v 2 οὗτος\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 29, "to": 55, "opening": 5, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}}, "coarser": false}}
  }
]
