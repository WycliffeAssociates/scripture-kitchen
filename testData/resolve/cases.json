[
  {
    "name": "the book is the whole text",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "book"},
    "expect": {"found": {"from": 0, "to": 74, "opening": 0, "covers": {"kind": "book"}, "coarser": false}}
  },
  {
    "name": "the intro is the front matter",
    "usfm": "\\id GEN\n\\mt1 Genesis\n\\c 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "intro"},
    "expect": {"found": {"from": 0, "to": 21, "opening": 0, "covers": {"kind": "intro"}, "coarser": false}}
  },
  {
    "name": "an empty intro is missing",
    "usfm": "\\c 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "intro"},
    "expect": {"missing": "intro"}
  },
  {
    "name": "one chapter runs to the next",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "chapters", "from": 2, "to": 2},
    "expect": {"found": {"from": 55, "to": 74, "opening": 55, "covers": {"kind": "chapters", "from": 2, "to": 2}, "coarser": false}}
  },
  {
    "name": "a chapter range spans its rows",
    "usfm": "\\id GEN\n\\c 1\n\\p a\n\\c 2\n\\p b\n\\c 3\n\\p c\n",
    "address": {"kind": "chapters", "from": 1, "to": 2},
    "expect": {"found": {"from": 8, "to": 28, "opening": 8, "covers": {"kind": "chapters", "from": 1, "to": 2}, "coarser": false}}
  },
  {
    "name": "two chapter 3s are ambiguous",
    "usfm": "\\id GEN\n\\c 3\n\\p a\n\\c 3\n\\p b\n",
    "address": {"kind": "chapters", "from": 3, "to": 3},
    "expect": {"ambiguous": [{"from": 8, "to": 18, "opening": 8}, {"from": 18, "to": 28, "opening": 18}]}
  },
  {
    "name": "a chapter the text lacks is missing",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "chapters", "from": 30, "to": 30},
    "expect": {"missing": "chapter"}
  },
  {
    "name": "a verse runs to the next verse or chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 39, "to": 55, "opening": 39, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a verse range spans both ends",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n\\v 2 b\n\\v 3 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 16, "to": 30, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a range may cross a chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 2, "verse": 1}},
    "expect": {"found": {"from": 39, "to": 74, "opening": 39, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 2, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "a verse in a bridge covers the bridge",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1-2 a b\n\\v 3 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 16, "to": 27, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a verse a list skips is missing",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1,3 a\n\\v 4 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"missing": "verse", "within": {"from": 8, "to": 32}}
  },
  {
    "name": "a verse a list names covers its hull",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1,3 a\n\\v 4 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"found": {"from": 16, "to": 25, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 3}}, "coarser": false}}
  },
  {
    "name": "a segment the text does not divide is found coarser",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 3 a\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "a"}, "to": {"chapter": 1, "verse": 3, "segment": "a"}},
    "expect": {"found": {"from": 16, "to": 23, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}}, "coarser": true}}
  },
  {
    "name": "a whole verse the text divides spans its segments",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 3a a\n\\v 3b b\n\\v 4 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"found": {"from": 16, "to": 32, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "a"}, "to": {"chapter": 1, "verse": 3, "segment": "b"}}, "coarser": false}}
  },
  {
    "name": "a segment the text divides is exact",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 3a a\n\\v 3b b\n\\v 4 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "b"}, "to": {"chapter": 1, "verse": 3, "segment": "b"}},
    "expect": {"found": {"from": 24, "to": 32, "opening": 24, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 3, "segment": "b"}, "to": {"chapter": 1, "verse": 3, "segment": "b"}}, "coarser": false}}
  },
  {
    "name": "two anchors for one verse are ambiguous",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 3 a\n\\v 3 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"ambiguous": [{"from": 16, "to": 23, "opening": 13}, {"from": 23, "to": 30, "opening": 23}]}
  },
  {
    "name": "a missing verse names its chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 9}, "to": {"chapter": 1, "verse": 9}},
    "expect": {"missing": "verse", "within": {"from": 8, "to": 55}}
  },
  {
    "name": "a range with a missing end is missing",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 9}},
    "expect": {"missing": "verse", "within": {"from": 8, "to": 55}}
  },
  {
    "name": "a verse in a missing chapter is a missing chapter",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 In the beginning.\n\\v 2 The earth.\n\\c 2\n\\p\n\\v 1 Thus.\n",
    "address": {"kind": "verses", "from": {"chapter": 7, "verse": 1}, "to": {"chapter": 7, "verse": 1}},
    "expect": {"missing": "chapter"}
  },
  {
    "name": "opening: a verse after a paragraph opens at the paragraph",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n\\p\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 26, "to": 33, "opening": 23, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: a heading and its text open the verse",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n\\s1 A heading\n\\p\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 40, "to": 47, "opening": 23, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: a poetry line opens the verse it starts",
    "usfm": "\\id GEN\n\\c 1\n\\q1 \\v 1 line one\n\\q2 line two\n\\q1 \\v 2 line three\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 48, "to": 64, "opening": 44, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: a blank line joins the run",
    "usfm": "\\id GEN\n\\c 1\n\\q1 \\v 1 a\n\\b\n\\q1 \\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 31, "to": 38, "opening": 24, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: mid-paragraph the opening is the verse",
    "usfm": "\\id GEN\n\\c 1\n\\p \\v 1 a \\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 23, "to": 30, "opening": 23, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: the first verse opens after its chapter marker",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 16, "to": 23, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a chapter label is not an opener",
    "usfm": "\\id GEN\n\\c 1\n\\cl Psalm 1\n\\p\n\\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 28, "to": 35, "opening": 25, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a psalm title is an opener",
    "usfm": "\\id GEN\n\\c 3\n\\d A psalm of David.\n\\q1 \\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 3, "verse": 1}, "to": {"chapter": 3, "verse": 1}},
    "expect": {"found": {"from": 38, "to": 45, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 3, "verse": 1}, "to": {"chapter": 3, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a range opens where its first verse does",
    "usfm": "\\id GEN\n\\c 1\n\\s1 Title\n\\p\n\\v 1 a\n\\p\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 26, "to": 43, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "non-ASCII text: offsets are bytes",
    "usfm": "\\id GEN\n\\c 1\n\\s1 Ἐν ἀρχῇ\n\\p\n\\v 1 ἦν ὁ λόγος\n\\v 2 οὗτος\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 63, "to": 80, "opening": 63, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "non-ASCII text: a heading opening",
    "usfm": "\\id GEN\n\\c 1\n\\s1 Ἐν ἀρχῇ\n\\p\n\\v 1 ἦν ὁ λόγος\n\\v 2 οὗτος\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 37, "to": 63, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a milestone inside a heading is transparent",
    "usfm": "\\id PSA\n\\c 3\n\\cl Psalm\n\\d \\zaln-s |x-strong=\"H4210\"\\*\\w A|x-occurrence=\"1\"\\w*\\zaln-e\\* psalm.\n\\q1 \\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 3, "verse": 1}, "to": {"chapter": 3, "verse": 1}},
    "expect": {"found": {"from": 98, "to": 105, "opening": 23, "covers": {"kind": "verses", "from": {"chapter": 3, "verse": 1}, "to": {"chapter": 3, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a milestone between heading and paragraph is transparent",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n\\s1 Head\n\\ts\\*\n\\p\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 41, "to": 48, "opening": 23, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "opening: a milestone after a psalm title is transparent",
    "usfm": "\\id PSA\n\\c 5\n\\cl Psalm\n\\d For the director.\n\n\\ts\\*\n\\q1 \\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 5, "verse": 1}, "to": {"chapter": 5, "verse": 1}},
    "expect": {"found": {"from": 55, "to": 62, "opening": 23, "covers": {"kind": "verses", "from": {"chapter": 5, "verse": 1}, "to": {"chapter": 5, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "opening: a chapter label between openers is transparent",
    "usfm": "\\id PSA\n\\c 1\n\\ms Book One\n\\cl Psalm\n\\q1 \\v 1 a\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 40, "to": 47, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 1}}, "coarser": false}}
  },
  {
    "name": "astral text: UTF-16 counts two units per scalar",
    "usfm": "\\id GEN\n\\c 1\n\\s1 😀 Head\n\\p\n\\v 1 a 𝔄\n\\v 2 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 30, "to": 49, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a reversed range spans the same verses",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1 a\n\\v 2 b\n\\v 3 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 1}},
    "expect": {"found": {"from": 16, "to": 30, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}}, "coarser": false}}
  },
  {
    "name": "a verse in a repeated chapter is an ambiguous chapter",
    "usfm": "\\id GEN\n\\c 3\n\\p\n\\v 1 a\n\\c 3\n\\p\n\\v 1 b\n",
    "address": {"kind": "verses", "from": {"chapter": 3, "verse": 1}, "to": {"chapter": 3, "verse": 1}},
    "expect": {"ambiguous": [{"from": 8, "to": 23, "opening": 8}, {"from": 23, "to": 38, "opening": 23}]}
  },
  {
    "name": "a range ending in a list gap is missing",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1,3 a\n\\v 4 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"missing": "verse", "within": {"from": 8, "to": 32}}
  },
  {
    "name": "a range checks only its ends",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1,3 a\n\\v 4 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 4}},
    "expect": {"found": {"from": 16, "to": 32, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 4}}, "coarser": false}}
  },
  {
    "name": "a part and a whole for one verse are ambiguous, in source order",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 3a a\n\\v 3 b\n\\v 4 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"ambiguous": [{"from": 16, "to": 24, "opening": 13}, {"from": 24, "to": 31, "opening": 24}]}
  },
  {
    "name": "lists that interleave cover their joint hull",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 1,3,5 a\n\\v 2,4 b\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 2}},
    "expect": {"found": {"from": 16, "to": 36, "opening": 13, "covers": {"kind": "verses", "from": {"chapter": 1, "verse": 1}, "to": {"chapter": 1, "verse": 5}}, "coarser": false}}
  },
  {
    "name": "overlapping segments for a whole verse are ambiguous",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 3a a\n\\v 3a-3b b\n\\v 4 c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"ambiguous": [{"from": 16, "to": 24, "opening": 13}, {"from": 24, "to": 35, "opening": 24}]}
  },
  {
    "name": "a bridge into a segment overlaps that segment",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 2-3a a\n\\v 3a b\n\\v 3b c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 3}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"ambiguous": [{"from": 16, "to": 26, "opening": 13}, {"from": 26, "to": 34, "opening": 26}, {"from": 34, "to": 42, "opening": 34}]}
  },
  {
    "name": "a range ending on an overlapped verse is ambiguous",
    "usfm": "\\id GEN\n\\c 1\n\\p\n\\v 2-3a a\n\\v 3a b\n\\v 3b c\n",
    "address": {"kind": "verses", "from": {"chapter": 1, "verse": 2}, "to": {"chapter": 1, "verse": 3}},
    "expect": {"ambiguous": [{"from": 16, "to": 26, "opening": 13}, {"from": 26, "to": 34, "opening": 26}, {"from": 34, "to": 42, "opening": 34}]}
  }
]
